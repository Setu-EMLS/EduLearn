@model Enrollment
@{
    ViewData["Title"] = "Certificate";
}
<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <a href="/Student/Certificates" class="btn btn-sm btn-light"><i class="fa-solid fa-arrow-left me-1"></i>All certificates</a>
    <button type="button" class="btn btn-brand" onclick="window.print()"><i class="fa-solid fa-print me-1"></i>Print / Save as PDF</button>
</div>

<partial name="_Certificate" model="Model" />
