@model Enrollment
@{
    ViewData["Title"] = "Certificate · " + Model.Student.Name;
}
<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    @if (Model.BatchId != null)
    {
        <a href="/Admin/Batch/Details/@Model.BatchId" class="btn btn-sm btn-light"><i class="fa-solid fa-arrow-left me-1"></i>Back to @Model.Batch!.Name</a>
    }
    else
    {
        <a href="/Admin/Enrollment" class="btn btn-sm btn-light"><i class="fa-solid fa-arrow-left me-1"></i>Enrollments</a>
    }
    <button type="button" class="btn btn-brand" onclick="window.print()"><i class="fa-solid fa-print me-1"></i>Print / Save as PDF</button>
</div>

<partial name="_Certificate" model="Model" />
