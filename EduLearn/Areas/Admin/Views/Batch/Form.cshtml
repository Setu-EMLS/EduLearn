@model Batch
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "New Batch" : "Edit Batch";
}
<div class="row justify-content-center">
    <div class="col-xl-8">
        <form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? (int?)null : Model.Id)" method="post" class="card-lms">
            <div class="card-lms-header"><h5>@ViewData["Title"]</h5></div>
            <div class="card-lms-body">
                <div asp-validation-summary="ModelOnly" class="mb-3"></div>
                <div class="row g-3 mb-3">
                    <div class="col-md-7">
                        <label asp-for="CourseId" class="form-label"></label>
                        @if (isNew)
                        {
                            <select asp-for="CourseId" asp-items="ViewBag.Courses" class="form-select">
                                <option value="0">— Select course —</option>
                            </select>
                            <span asp-validation-for="CourseId"></span>
                        }
                        else
                        {
                            <input class="form-control" value="@Model.Course?.Title" disabled />
                            <input type="hidden" asp-for="CourseId" />
                        }
                    </div>
                    <div class="col-md-5">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Batch 05 or Jan-2027 Evening" />
                        <span asp-validation-for="Name"></span>
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="StartDate" class="form-label"></label>
                        <input asp-for="StartDate" class="form-control" type="date" />
                        <span asp-validation-for="StartDate"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EndDate" class="form-label">End date <span class="text-muted fw-normal">(optional)</span></label>
                        <input asp-for="EndDate" class="form-control" type="date" />
                        <span asp-validation-for="EndDate"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="Schedule" class="form-label"></label>
                    <input asp-for="Schedule" class="form-control" placeholder="e.g. Sat, Mon, Wed 7.00 pm - 9.00 pm" />
                    <span asp-validation-for="Schedule"></span>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-7">
                        <label asp-for="TeacherId" class="form-label"></label>
                        <select asp-for="TeacherId" asp-items="ViewBag.Teachers" class="form-select">
                            <option value="">Course teacher</option>
                        </select>
                        <div class="form-text">The trainer can also manage this course from the Teacher panel.</div>
                        <span asp-validation-for="TeacherId"></span>
                    </div>
                    <div class="col-md-5">
                        <label asp-for="Seats" class="form-label"></label>
                        <input asp-for="Seats" class="form-control" type="number" min="1" placeholder="Unlimited" />
                        <div class="form-text">Pending payment requests also hold a seat.</div>
                        <span asp-validation-for="Seats"></span>
                    </div>
                </div>
                <div class="form-check form-switch">
                    <input asp-for="IsAdmissionOpen" class="form-check-input" role="switch" />
                    <label asp-for="IsAdmissionOpen" class="form-check-label">Admission open — students can choose this batch when they enroll</label>
                </div>
            </div>
            <div class="card-lms-body border-top d-flex gap-2">
                <button type="submit" class="btn btn-brand px-4">@(isNew ? "Create batch" : "Save")</button>
                <a asp-action="Index" asp-route-courseId="@(Model.CourseId > 0 ? Model.CourseId : (int?)null)" class="btn btn-light">Cancel</a>
            </div>
        </form>
    </div>
</div>
