@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}
<div class="welcome-banner d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <h3>Welcome back, @User.GetDisplayName()!</h3>
        <p>Here is what is happening across EduLearn today.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (Model.PendingEnrollments > 0)
        {
            <a href="/Admin/Enrollment?status=Pending" class="btn btn-light fw-semibold">
                <i class="fa-solid fa-hourglass-half me-1"></i> @Model.PendingEnrollments enrollment@(Model.PendingEnrollments == 1 ? "" : "s") waiting for approval
            </a>
        }
        @if (Model.NewInquiries > 0)
        {
            <a href="/Admin/Inquiry" class="btn btn-light fw-semibold">
                <i class="fa-solid fa-envelope-open-text me-1"></i> @Model.NewInquiries new website message@(Model.NewInquiries == 1 ? "" : "s")
            </a>
        }
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <a href="/Admin/Student" class="stat-card">
            <span class="stat-icon tone-blue"><i class="fa-solid fa-graduation-cap"></i></span>
            <div><div class="stat-value">@Model.TotalStudents</div><div class="stat-label">Students</div></div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a href="/Admin/Teacher" class="stat-card">
            <span class="stat-icon tone-violet"><i class="fa-solid fa-person-chalkboard"></i></span>
            <div><div class="stat-value">@Model.TotalTeachers</div><div class="stat-label">Teachers</div></div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a href="/Admin/Course" class="stat-card">
            <span class="stat-icon tone-teal"><i class="fa-solid fa-book"></i></span>
            <div><div class="stat-value">@Model.PublishedCourses <small class="fs-6 text-muted">/ @Model.TotalCourses</small></div><div class="stat-label">Published courses</div></div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a href="/Admin/Report" class="stat-card">
            <span class="stat-icon tone-amber"><i class="fa-solid fa-sack-dollar"></i></span>
            <div><div class="stat-value">@UiHelpers.Money(Model.Revenue)</div><div class="stat-label">Total revenue</div></div>
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <a href="/Admin/Enrollment?status=Pending" class="stat-card">
            <span class="stat-icon tone-amber"><i class="fa-solid fa-hourglass-half"></i></span>
            <div><div class="stat-value">@Model.PendingEnrollments</div><div class="stat-label">Pending enrollments</div></div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="/Admin/Enrollment?status=Active" class="stat-card">
            <span class="stat-icon tone-blue"><i class="fa-solid fa-person-running"></i></span>
            <div><div class="stat-value">@Model.ActiveEnrollments</div><div class="stat-label">Active learners</div></div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="/Admin/Enrollment?status=Completed" class="stat-card">
            <span class="stat-icon tone-teal"><i class="fa-solid fa-award"></i></span>
            <div><div class="stat-value">@Model.CompletedEnrollments</div><div class="stat-label">Course completions</div></div>
        </a>
    </div>
</div>

<div class="card-lms mb-4">
    <div class="card-lms-header">
        <h5><i class="fa-solid fa-award text-brand me-1"></i> Completed courses &amp; certificates</h5>
        <a href="/Admin/Enrollment?status=Completed" class="btn btn-sm btn-outline-brand">View all (@Model.CompletedEnrollments)</a>
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>Student</th><th>Course</th><th>Completed</th><th>Certificate no.</th><th class="text-end">Certificate</th></tr></thead>
            <tbody>
                @foreach (var c in Model.RecentCertificates)
                {
                    <tr>
                        <td class="text-nowrap">
                            <a href="/Admin/Student/Details/@c.StudentId" class="fw-semibold">@c.Student.Name</a>
                            <small class="d-block text-muted">@c.Student.StudentID</small>
                        </td>
                        <td>
                            @c.Course.Title @if (c.Course.IsOffline) { <span class="badge bg-dark">Offline</span> }
                            @if (c.Batch != null) { <small class="d-block"><i class="fa-solid fa-people-group me-1 text-muted"></i><a href="/Admin/Batch/Details/@c.BatchId">@c.Batch.Name</a></small> }
                        </td>
                        <td class="text-nowrap">@(c.CompletedAt?.ToString("dd MMM yyyy") ?? "—")</td>
                        <td>@if (!string.IsNullOrEmpty(c.CertificateNo)) { <code>@c.CertificateNo</code> } else { <span class="text-muted">—</span> }</td>
                        <td class="text-end text-nowrap">
                            <a href="/Admin/Enrollment/Certificate/@c.Id" class="btn btn-sm btn-outline-brand" title="View / print certificate"><i class="fa-solid fa-print me-1"></i>Print</a>
                        </td>
                    </tr>
                }
                @if (!Model.RecentCertificates.Any())
                {
                    <tr><td colspan="5" class="empty-state"><i class="fa-solid fa-award"></i>No course has been completed yet. Certificates appear here as students finish their courses.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="row g-3">
    <div class="col-xl-7">
        <div class="card-lms h-100">
            <div class="card-lms-header">
                <h5>Recent enrollments</h5>
                <a href="/Admin/Enrollment" class="btn btn-sm btn-outline-brand">View all</a>
            </div>
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead><tr><th>Student</th><th>Course</th><th>Date</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var e in Model.RecentEnrollments)
                        {
                            <tr>
                                <td class="text-nowrap"><a href="/Admin/Student/Details/@e.StudentId">@e.Student.Name</a></td>
                                <td>@e.Course.Title</td>
                                <td class="text-nowrap">@e.EnrolledAt.ToString("dd MMM yyyy")</td>
                                <td><span class="badge @UiHelpers.StatusBadge(e.Status)">@e.Status</span></td>
                            </tr>
                        }
                        @if (!Model.RecentEnrollments.Any())
                        {
                            <tr><td colspan="4" class="empty-state">No enrollments yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-xl-5">
        <div class="card-lms h-100">
            <div class="card-lms-header">
                <h5>Top courses</h5>
                <a href="/Admin/Report" class="btn btn-sm btn-outline-brand">Reports</a>
            </div>
            <div class="card-lms-body">
                <ul class="list-clean">
                    @foreach (var c in Model.TopCourses)
                    {
                        <li class="d-flex justify-content-between align-items-center gap-2">
                            <div class="min-w-0">
                                <div class="fw-semibold text-truncate">@c.Title</div>
                                <small class="text-muted">@(c.TeacherName ?? "No teacher assigned") · @(c.IsPublished ? "Published" : "Draft")</small>
                            </div>
                            <div class="text-end text-nowrap">
                                <span class="fw-bold">@c.Enrolled</span> <small class="text-muted">student@(c.Enrolled == 1 ? "" : "s")</small>
                                @if (c.Pending > 0)
                                {
                                    <div><span class="badge bg-warning text-dark">@c.Pending pending</span></div>
                                }
                            </div>
                        </li>
                    }
                    @if (!Model.TopCourses.Any())
                    {
                        <li class="empty-state"><i class="fa-solid fa-book"></i>No courses yet. <a href="/Admin/Course/Create">Create one</a>.</li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>
