@model LiveClass
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Schedule Live Class" : "Edit Live Class";
    var modules = (List<CourseSection>)ViewBag.TopicModules;
    var selectedTopics = (HashSet<int>)ViewBag.SelectedTopicIds;
}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? (int?)null : Model.Id)" method="post" class="card-lms">
            <div class="card-lms-header"><h5>@ViewData["Title"]</h5></div>
            <div class="card-lms-body">
                <div asp-validation-summary="ModelOnly" class="mb-3"></div>
                <div class="mb-3">
                    <label asp-for="CourseId" class="form-label"></label>
                    <select asp-for="CourseId" asp-items="ViewBag.Courses" class="form-select">
                        <option value="0">— Select course —</option>
                    </select>
                    <span asp-validation-for="CourseId"></span>
                </div>
                <partial name="_BatchSelect" model="@(new BatchSelectModel { Selected = Model.BatchId, Batches = ViewBag.Batches, Hint = "Pick a batch to show the class only to its students, or keep All batches." })" />
                <span asp-validation-for="BatchId" class="d-block mt-n2 mb-3"></span>
                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" placeholder="e.g. Doubt clearing session" />
                    <span asp-validation-for="Title"></span>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-7">
                        <label asp-for="StartsAt" class="form-label"></label>
                        <input asp-for="StartsAt" class="form-control" type="datetime-local" />
                        <span asp-validation-for="StartsAt"></span>
                    </div>
                    <div class="col-md-5">
                        <label asp-for="DurationMinutes" class="form-label"></label>
                        <input asp-for="DurationMinutes" class="form-control" type="number" min="5" max="600" />
                        <span asp-validation-for="DurationMinutes"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="MeetingUrl" class="form-label"></label>
                    <input asp-for="MeetingUrl" class="form-control" placeholder="https://meet.google.com/... or https://zoom.us/j/..." />
                    <span asp-validation-for="MeetingUrl"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Agenda, meeting passcode, things to prepare..."></textarea>
                </div>
                <div class="mb-0">
                    <label class="form-label">Topics covered in this class</label>
                    <div class="border rounded p-2" style="max-height:320px;overflow:auto">
                        <div class="text-muted small" id="topicHint">Select a course to choose its topics.</div>
                        @foreach (var course in modules.GroupBy(m => m.CourseId))
                        {
                            <div class="topic-course" data-course="@course.Key" style="display:none">
                                @foreach (var m in course.OrderBy(m => m.SortOrder))
                                {
                                    <div class="fw-semibold small text-uppercase text-brand mt-2">@m.Title</div>
                                    @foreach (var l in m.Lessons.OrderBy(l => l.SortOrder))
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input topic-check" type="checkbox" name="topicIds" value="@l.Id" id="topic-@l.Id" checked="@selectedTopics.Contains(l.Id)" />
                                            <label class="form-check-label" for="topic-@l.Id">@l.Title</label>
                                        </div>
                                    }
                                    @if (!m.Lessons.Any()) { <div class="text-muted small ms-1">No topics in this module yet.</div> }
                                }
                            </div>
                        }
                    </div>
                    <div class="form-text">Students see these topics on their class schedule. Add modules and topics on the course's Curriculum page.</div>
                    @Html.ValidationMessage("topicIds", new { @class = "text-danger small" })
                </div>
            </div>
            <div class="card-lms-body border-top d-flex gap-2">
                <button type="submit" class="btn btn-brand px-4">Save</button>
                <a asp-action="Index" class="btn btn-light">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var course = document.getElementById('CourseId');
            var hint = document.getElementById('topicHint');
            function sync() {
                var id = course ? course.value : '0';
                var shown = false;
                document.querySelectorAll('.topic-course').forEach(function (g) {
                    var match = g.getAttribute('data-course') === id;
                    g.style.display = match ? '' : 'none';
                    if (match) shown = true;
                    // topics of other courses must not be submitted
                    if (!match) g.querySelectorAll('.topic-check').forEach(function (c) { c.checked = false; });
                });
                hint.style.display = shown ? 'none' : '';
                hint.textContent = (!id || id === '0') ? 'Select a course to choose its topics.' : 'This course has no modules or topics yet. Add them on its Curriculum page.';
            }
            if (course) course.addEventListener('change', sync);
            sync();
        })();
    </script>
}
