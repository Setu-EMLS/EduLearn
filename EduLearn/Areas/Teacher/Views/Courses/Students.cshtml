@using EduLearn.Services.Interfaces
@model Course
@{
    ViewData["Title"] = "Students · " + Model.Title;
    var enrollments = (List<Enrollment>)ViewBag.Enrollments;
    var progress = (Dictionary<int, CourseProgress>)ViewBag.Progress;
    var submitted = (Dictionary<int, int>)ViewBag.Submitted;
    var bestQuiz = (Dictionary<int, int>)ViewBag.BestQuiz;
    var assignmentBatchIds = (List<int?>)ViewBag.AssignmentBatchIds;
    var batch = ViewBag.Batch as Batch;
    var batchCounts = (Dictionary<int, int>)ViewBag.BatchCounts;
    int totalWithAccess = ViewBag.TotalWithAccess;
    var hasBatches = Model.Batches.Any();
}
<div class="page-head">
    <div>
        <h2>@Model.Title@(batch != null ? " · " + batch.Name : "")</h2>
        <p>
            @enrollments.Count student@(enrollments.Count == 1 ? "" : "s") with access to this @(batch != null ? "batch" : "course").
            @if (batch != null)
            {
                <br /><i class="fa-regular fa-calendar me-1"></i>@batch.StartDate.ToString("dd MMM yyyy")@(batch.EndDate != null ? " – " + batch.EndDate.Value.ToString("dd MMM yyyy") : "")
                @if (!string.IsNullOrEmpty(batch.Schedule)) { <span class="ms-2"><i class="fa-regular fa-clock me-1"></i>@batch.Schedule</span> }
                <span class="ms-2"><i class="fa-solid fa-person-chalkboard me-1"></i>@(batch.Teacher?.Name ?? "Course teacher")</span>
            }
        </p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-light" onclick="window.print()"><i class="fa-solid fa-print me-1"></i> Print</button>
        <a href="/Teacher/Curriculum/Index/@Model.Id" class="btn btn-outline-brand"><i class="fa-solid fa-list-ol me-1"></i> Curriculum</a>
    </div>
</div>

@if (hasBatches)
{
    <ul class="nav nav-pills gap-2 mb-3 flex-wrap">
        <li class="nav-item"><a class="nav-link @(batch == null ? "active" : "")" href="/Teacher/Courses/Students/@Model.Id">All batches <span class="badge bg-light text-dark ms-1">@totalWithAccess</span></a></li>
        @foreach (var b in Model.Batches.OrderByDescending(b => b.StartDate))
        {
            <li class="nav-item"><a class="nav-link @(batch?.Id == b.Id ? "active" : "")" href="/Teacher/Courses/Students/@Model.Id?batchId=@b.Id">@b.Name <span class="badge bg-light text-dark ms-1">@batchCounts.GetValueOrDefault(b.Id)</span></a></li>
        }
    </ul>
}

<div class="card-lms">
    <div class="card-lms-body">
        <div class="table-responsive">
            <table class="table datatable">
                <thead><tr><th>Student</th>@if (hasBatches && batch == null) { <th>Batch</th> }<th>Contact</th><th>Lesson progress</th><th>Assignments</th><th>Quiz avg.</th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var e in enrollments)
                    {
                        var p = progress.GetValueOrDefault(e.Id, new CourseProgress(0, 0));
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <img src="@UiHelpers.Avatar(e.Student.PhotoPath)" class="avatar-sm" alt="" />
                                    <div><div class="fw-semibold">@e.Student.Name</div><small class="text-muted">@e.Student.StudentID</small></div>
                                </div>
                            </td>
                            @if (hasBatches && batch == null) { <td>@(e.Batch?.Name ?? "—")</td> }
                            <td><div>@e.Student.Email</div><small class="text-muted">@e.Student.Contact</small></td>
                            <td style="min-width:150px" data-order="@p.Percent">
                                <div class="progress mb-1"><div class="progress-bar" style="width:@p.Percent%"></div></div>
                                <small class="text-muted">@p.Completed / @p.Total (@p.Percent%)</small>
                            </td>
                            <td>@submitted.GetValueOrDefault(e.StudentId) / @assignmentBatchIds.Count(b => b == null || b == e.BatchId)</td>
                            <td>@(bestQuiz.TryGetValue(e.StudentId, out var q) ? q + "%" : "—")</td>
                            <td><span class="badge @UiHelpers.StatusBadge(e.Status)">@e.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
